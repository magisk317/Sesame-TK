<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!--Appbar背景色-->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!--ToolBar上的Title颜色-->
        <item name="titleTextColor">@color/active_text</item>
        <item name="subtitleTextColor">@color/active_text</item>
        <!-- 核心修改 1: 设置状态栏颜色为透明 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- <item name="android:windowTranslucentStatus">true</item>-->
        <item name="android:windowTranslucentStatus">false</item>
        <!-- 推荐新增：让导航栏也变透明 (可选) -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="windowNoTitle">true</item>
        <!-- 设置actionOverflowMenuStyle以自定义菜单的背景 -->
        <item name="actionOverflowMenuStyle">@style/MenuTheme</item>
    </style>


    <style name="MenuTheme">
        <item name="android:textColorSecondary">@color/textColorPrimary</item>
        <item name="android:popupBackground">@drawable/menu_background</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:itemBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
    </style>
</resources>
